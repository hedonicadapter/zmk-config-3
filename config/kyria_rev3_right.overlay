#include "kyria.dtsi"

&pro_micro_i2c {
    status = "okay";

    glidepoint: glidepoint@0 {
        compatible = "cirque,pinnacle";
        reg = <0>;
        spi-max-frequency = <1000000>;
        status = "okay";
        dr-gpios = <&gpio1 2 (GPIO_ACTIVE_HIGH)>;

        sensitivity = "2x";
        y-invert;
    };
};

&glidepoint_split {
    device = <&glidepoint>;

    input-processors = <&zip_temp_layer 4 500>;
};
